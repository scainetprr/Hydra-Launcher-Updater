{
  "name": "hydra-launcher",
  "version": "1.3.12",
  "description": "Hydra Launcher - Launcher original para HyperHard Network y Eventos Hydra",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "vite build --config vite.electron.config.ts && electron .",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron electron/main.js\"",
    "electron:build": "vite build && electron-builder",
    "lint": "eslint ."
  },
  "keywords": [
    "minecraft",
    "launcher",
    "hydra",
    "original",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.0",
    "electron-updater": "^6.8.9",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.0",
    "electron": "^30.5.1",
    "electron-builder": "^24.9.0",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "skinview3d": "^3.4.2",
    "tailwindcss": "^3.4.3",
    "terser": "^5.36.0",
    "three": "^0.186.1",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "wait-on": "^7.2.0",
    "zustand": "^4.5.0"
  },
  "build": {
    "compression": "maximum",
    "appId": "com.hydralauncher.app",
    "productName": "Hydra Launcher",
    "copyright": "Copyright © 2026 Dylan David Gomez (scainetprr)",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "scainetprr",
      "repo": "hydra-launcher-web"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Hydra Launcher",
      "menuCategory": "Hydra Studio",
      "runAfterFinish": true,
      "artifactName": "Hydra-Launcher-Setup-v${version}.${ext}",
      "warningsAsErrors": false
    }
  }
}
